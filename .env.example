# ============================================================
# 思晨五金官网 · 一键发布配置
# 复制本文件为 .env（.env 已被 git 忽略，不会上传密钥）
# ============================================================

# 腾讯云访问密钥：https://console.cloud.tencent.com/cam/capi
# 建议创建"子用户"并仅授权该存储桶读写权限，不要把主账号密钥写在这里
COS_SECRET_ID=你的SecretId
COS_SECRET_KEY=你的SecretKey

# 存储桶名称（含 APPID 后缀）。
# 在 COS 控制台「存储桶列表」的"名称"列可看到，形如：sicenweb-1250000000
COS_BUCKET=你的桶名称-APPID

# 存储桶地域（与建桶时一致）：广州 ap-guangzhou / 香港 ap-hongkong 等
COS_REGION=ap-guangzhou

# 可选：设为 true 时，发布后会删除云端已不在本地 dist 中的文件（谨慎使用）
COS_CLEAN=false
