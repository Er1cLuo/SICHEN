---
interface Props {
  current?: string;
}

const { current = '/' } = Astro.props;

const nav = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于我们' },
  { href: '/products', label: '产品中心' },
  { href: '/workshops', label: '厂区展示' },
];

// 桌面端右侧已有白底「联系我们」按钮，导航里不再重复；
// 手机端按钮隐藏，所以全屏菜单里补上「联系我们」。
const mobileNav = [...nav, { href: '/contact', label: '联系我们' }];

const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header" id="siteHeader">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="思晨五金制品有限公司 首页">
      <span class="brand__mark">
        <img src="/logo.svg" alt="思晨五金 logo" width="40" height="40" />
      </span>
      <span class="brand__text">
        <span class="brand__name">思晨五金</span>
        <span class="brand__sub">SICEN HARDWARE</span>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a class:list={['nav__link', { 'is-active': isActive(item.href) }]} href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      class="btn btn--solid btn--sm nav__cta"
      href="/contact"
      aria-current={isActive('/contact') ? 'page' : undefined}>联系我们</a
    >

    <button class="hamburger" id="menuToggle" type="button" aria-label="打开菜单" aria-expanded="false">
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    {
      mobileNav.map((item) => (
        <a class="mobile-menu__link" href={item.href}>
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  const header = document.getElementById('siteHeader');

  const onScroll = () => {
    header?.classList.toggle('scrolled', window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('open', open);
    toggle?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('open') ?? false;
    setMenu(!isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>
