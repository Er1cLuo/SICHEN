---
interface Props {
  current?: string;
}

const { current = '/' } = Astro.props;

const nav = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于我们' },
  { href: '/products', label: '产品中心' },
  { href: '/workshops', label: '车间概貌' },
  { href: '/contact', label: '联系我们' },
];

const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header" id="siteHeader">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="思晨五金制品有限公司 首页">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <path d="M16 3 28 10.5v11L16 29 4 21.5v-11z" stroke="#f4f4f0" stroke-width="1.3" />
          <circle cx="16" cy="16" r="4.6" stroke="#f4f4f0" stroke-width="1.3" />
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">思晨五金</span>
        <span class="brand__sub">SICEN HARDWARE</span>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a class:list={['nav__link', { 'is-active': isActive(item.href) }]} href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="btn btn--solid btn--sm nav__cta" href="/contact">联系我们</a>

    <button class="hamburger" id="menuToggle" type="button" aria-label="打开菜单" aria-expanded="false">
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    {
      nav.map((item) => (
        <a class="mobile-menu__link" href={item.href}>
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  const header = document.getElementById('siteHeader');

  const onScroll = () => {
    header?.classList.toggle('scrolled', window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('open', open);
    toggle?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('open') ?? false;
    setMenu(!isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>
