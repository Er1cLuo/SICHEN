---
/**
 * 视频组件，三种用法：
 *
 * 1) 视频平台嵌入（目前线上用的就是这种）—— 懒加载：先显示封面，点击后才加载播放器
 *   <VideoPlaceholder
 *     embed="https://player.bilibili.com/player.html?bvid=BV1s8aq6FEbG&..."
 *     poster="/videos/video.jpg"
 *     label="品牌视频"
 *   />
 *
 * 2) 自建 mp4（注意：EdgeOne 构建产物单文件上限 25 MiB）
 *   <VideoPlaceholder src="/videos/video.mp4" poster="/videos/video.jpg" label="品牌视频" />
 *   自建模式按"只允许窗口播放"处理：controlsList="nofullscreen" + 禁画中画 + 脚本兜底退出全屏
 *
 * 3) 都不给 → 显示占位框（提示待上传）
 *
 * 窗口宽度由外层 .video-frame 控制（内容的 3/4，居中，≤900px 占满）。
 */
interface Props {
  label?: string;
  hint?: string;
  /** 自建视频地址，例如 /videos/video.mp4 */
  src?: string;
  /** 平台嵌入地址（B站 / YouTube / 腾讯视频的 iframe src） */
  embed?: string;
  /** 封面图地址（可选），建议 16:9 */
  poster?: string;
}

const { label = '品牌视频', hint, src, embed, poster } = Astro.props;

const mime = src?.endsWith('.webm')
  ? 'video/webm'
  : src?.endsWith('.ogv')
    ? 'video/ogg'
    : 'video/mp4';

// B站 播放器参数：关弹幕、允许切清晰度、宽屏、不自动播放（企业官网观感更干净）
const embedSrc = embed;
---

<div
  class:list={['video-ph', { 'video-ph--live': !!src || !!embed, 'video-ph--embed': !!embed }]}
  data-reveal
  data-embed={embedSrc}
>
  {
    embed ? (
      <div class="video-ph__facade">
        {poster ? (
          <img class="video-ph__poster" src={poster} alt={label} loading="lazy" />
        ) : (
          <span class="video-ph__poster video-ph__poster--blank" aria-hidden="true" />
        )}
        <button class="video-ph__play" type="button" aria-label={`播放${label}`} />
      </div>
    ) : src ? (
      <video
        controls
        playsinline
        disablepictureinpicture
        controlslist="nofullscreen noremoteplayback"
        preload="metadata"
        poster={poster}
        aria-label={label}
      >
        <source src={src} type={mime} />
        您的浏览器不支持 HTML5 视频播放。
      </video>
    ) : (
      <>
        <button class="video-ph__play" type="button" aria-label="播放视频" />
        <span class="video-ph__label">{label}</span>
        {hint && <span class="video-ph__hint">{hint}</span>}
      </>
    )
  }
</div>

<script>
  /* 平台嵌入：点击封面才真正加载 iframe（首屏不加载第三方播放器，也不带三方 cookie） */
  document.querySelectorAll<HTMLElement>('.video-ph--embed').forEach((wrap) => {
    const url = wrap.dataset.embed;
    if (!url) return;
    const facade = wrap.querySelector('.video-ph__facade');
    const start = () => {
      const iframe = document.createElement('iframe');
      iframe.src = url;
      iframe.className = 'video-ph__iframe';
      iframe.setAttribute('scrolling', 'no');
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture; encrypted-media');
      iframe.setAttribute(
        'allowfullscreen',
        'true' /* 想禁止全屏：删掉这一行，并把上面的 allow 里的 fullscreen 去掉 */,
      );
      iframe.setAttribute('title', wrap.querySelector('.video-ph__poster')?.getAttribute('alt') ?? '视频');
      wrap.replaceChildren(iframe);
    };
    facade?.querySelector('.video-ph__play')?.addEventListener('click', start);
    facade?.querySelector('.video-ph__poster')?.addEventListener('click', start);
  });

  /* 自建视频：兜底退出全屏（Safari / Firefox 不认 controlsList 时） */
  document.querySelectorAll<HTMLVideoElement>('.video-ph video').forEach((video) => {
    const doc = document as Document & {
      webkitFullscreenElement?: Element;
      webkitExitFullscreen?: () => void;
    };
    const vid = video as HTMLVideoElement & { webkitExitFullscreen?: () => void };
    const exitIfFullscreen = () => {
      if (document.fullscreenElement) document.exitFullscreen?.().catch(() => {});
      else if (doc.webkitFullscreenElement) doc.webkitExitFullscreen?.();
      else if (vid.webkitDisplayingFullscreen) vid.webkitExitFullscreen?.();
    };
    document.addEventListener('fullscreenchange', exitIfFullscreen);
    document.addEventListener('webkitfullscreenchange', exitIfFullscreen);
    video.addEventListener('webkitbeginfullscreen', exitIfFullscreen);
  });
</script>
