---
// 页脚
const navLinks = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于我们' },
  { href: '/products', label: '产品中心' },
  { href: '/workshops', label: '厂区展示' },
  { href: '/contact', label: '联系我们' },
];

const productLinks = [
  { href: '/products#nut', label: '螺母类' },
  { href: '/products#screw', label: '一般冷镦螺丝件' },
  { href: '/products#special', label: '多工位冷镦异形件' },
  { href: '/products#washer', label: '冲压垫片' },
  { href: '/products#turning', label: '车床件' },
  { href: '/products#other', label: '其他异形类' },
];

const workshopLinks = [
  { href: '/workshops#part-1', label: '冷镦成型' },
  { href: '/workshops#part-2', label: '搓牙' },
  { href: '/workshops#part-3', label: '数控加工' },
  { href: '/workshops#part-4', label: '光学筛选' },
  { href: '/workshops#part-5', label: '仓储' },
  { href: '/workshops#part-6', label: '包装' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__about">
        <a class="brand" href="/" aria-label="思晨五金制品有限公司 首页">
          <span class="brand__mark">
            <img src="/logo.svg" alt="思晨五金 logo" width="40" height="40" />
          </span>
          <span class="brand__text">
            <span class="brand__name">思晨五金</span>
            <span class="brand__sub">SICEN HARDWARE</span>
          </span>
        </a>
        <p>
          思晨五金制品有限公司专注于精密五金制品的研发、制造与交付，
          以严谨的工艺与稳定的品质，为全球工业客户提供可靠的解决方案。
        </p>
      </div>

      <div class="footer__col">
        <h4 class="footer__title">快速导航</h4>
        <ul class="footer__links">
          {
            navLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col">
        <h4 class="footer__title">产品分类</h4>
        <ul class="footer__links">
          {
            productLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col">
        <h4 class="footer__title">厂区展示</h4>
        <ul class="footer__links">
          {
            workshopLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col footer__col--contact">
        <h4 class="footer__title">联系方式</h4>
        <ul class="footer__contact">
          <li>
            <span>地址</span>
            <span>广东省中山市三乡镇第二工业区皇冠路5号8栋之A区</span>
          </li>
          <li>
            <span>电话</span>
            <span><a href="tel:+8613928180479">139 2818 0479</a></span>
          </li>
          <li>
            <span>邮箱</span>
            <span>2724247155@qq.com</span>
          </li>
          <li>
            <span>时间</span>
            <span>周一至周六 8:30 – 18:00</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© 2025 思晨五金制品有限公司 · SICEN HARDWARE PRODUCTS CO., LTD.</span>
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">粤ICP备2026136130号</a>
    </div>
  </div>
</footer>
