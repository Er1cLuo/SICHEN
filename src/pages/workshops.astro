        desc: '成品分拣、包装与出货管理，按约定交期准时交付，支持长期合作客户的备货需求。',
        note: '流程：分拣 — 包装 — 出货登记｜按交期排程发货｜可协商备货与分批交付',
        images: [
          '/images/factory/finished-warehouse.jpg',
          '/images/factory/finished-warehouse-2.png',
        ],
      },
    ],
  },
  {
    id: 'part-6',
    eyebrow: 'PART 06',
    title: '包装',
    craft: crafts.packing,
    desc: '出货前的计数包装工序：自动计数，按客户要求定袋型与每包数量，完成后按批次登记入库。',
    items: [
      {
        id: 'packing',
        compact: true,
        title: '包装车间',
        en: 'PACKING WORKSHOP',
        desc: '配全自动螺丝计数包装机，可按客户要求定袋型与每包数量，缺料自动报警。',
        specs: [
          { k: '计数精度', v: '1000 粒误差 ≤ 1 粒' },
          { k: '包装速度', v: '25 ~ 180 包/分钟（常规 30 ~ 70 包/分钟）' },
          { k: '适用产品', v: '螺丝、螺母、垫片、五金配件' },
        ],
        note: '检测：包装数量实时显示 + 缺料自动停机报警｜按批次登记入库',
        images: [
          '/images/factory/packing-1.png',
        ],
      },
    ],
  },
];

/** 工艺特点见文件顶部 crafts */
---

<Layout
  title="厂区展示"
  description="思晨五金厂区展示——冷镦成型、搓牙、数控加工、光学筛选、仓储与包装，完整呈现生产现场与制造能力。"
>

  <section class="page-hero page-hero--media">
    <!-- 页头背景大图：换图只需改下面这一行，或把同名文件放进 public/images/company/ 覆盖 -->
    <div class="page-hero__bg" aria-hidden="true">
      <img src="/images/company/showfactory.jpg" alt="" />
    </div>
    <div class="page-hero__scrim" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow" data-reveal>OUR FACILITY</p>
      <h1 class="page-hero__title" data-reveal>厂区展示</h1>
      <p class="page-hero__desc" data-reveal>
        从冷镦成型、搓牙、数控加工、仓储到光学筛选，完整呈现思晨的生产现场。
      </p>
      <nav class="anchor-nav" aria-label="厂区导航">
        {
          parts.map((p) => (
            <a class="anchor-pill" href={`#${p.id}`}>
              {p.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    parts.map((part, index) => (
      <section class:list={['section', { 'section--alt': index % 2 === 1 }]} id={part.id}>
        <div class="container">
          <SectionHeading eyebrow={part.eyebrow} title={part.title} desc={part.desc} />

          {part.items.map((item, itemIndex) => {
            const no = String(itemIndex + 1).padStart(2, '0');
            // 图片比例：compact（冷镦 / 数控）用更扁的图；也可用 item.thumbAspect 单独指定
            const heroAspect = item.compact ? '21/9' : '16/9';
            const smallAspect = item.thumbAspect ?? (item.compact ? '16/9' : '4/3');
            return (
              <article class="shop-feature" id={item.id}>
                <div class="shop-feature__media">
                  {item.images.length >= 3 ? (
                    <>
                      <div class="shop-feature__hero">
                        <PlaceholderImage src={item.images[0]} label={`${item.title} · 全景`} aspect={heroAspect} />
                      </div>
                      <div class="shop-feature__thumbs">
                        <PlaceholderImage src={item.images[1]} label={`${item.title} · 细节 1`} aspect={smallAspect} />
                        <PlaceholderImage src={item.images[2]} label={`${item.title} · 细节 2`} aspect={smallAspect} />
                      </div>
                    </>
                  ) : (
                    /* 只有 1 ~ 2 张图时：等宽并排，不留空槽 */
                    <div class="shop-feature__row">
                      {item.images.map((src, i) => (
                        <PlaceholderImage
                          src={src}
                          label={`${item.title} · ${i === 0 ? '全景' : `细节 ${i}`}`}
                          aspect={smallAspect}
                        />
                      ))}
                    </div>
                  )}
                </div>

                <div class="shop-feature__info" data-reveal>
                  <div class="shop-feature__head">
                    <span class="shop-feature__index">{no}</span>
                    <p class="eyebrow">{item.en}</p>
                  </div>
                  <h3 class="shop-feature__title">{item.title}</h3>
                  <p class="shop-feature__desc">{item.desc}</p>
                  {item.specs && (
                    <dl class="shop-feature__specs">
                      {item.specs.map((spec) => (
                        <div>
                          <dt>{spec.k}</dt>
                          <dd>{spec.v}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  <p class="shop-feature__note">{item.note}</p>
                </div>
              </article>
            );
          })}

          {
            part.craft && (
              <div class="craft-block">
                <div class="craft-block__head">
                  <h3 class="craft-block__title">{part.craft.title}</h3>
                  <p class="craft-block__hint">{part.craft.hint}</p>
                </div>
                <ul class="craft-grid">
                  {part.craft.points.map((point) => (
                    <li class="craft-item" data-reveal>
                      <p class="craft-item__no">{point.no}</p>
                      <h4 class="craft-item__title">{point.title}</h4>
                      <p class="craft-item__desc">{point.desc}</p>
                    </li>
                  ))}
                </ul>
                <p class="craft-limit">{part.craft.limit}</p>
              </div>
            )
          }
        </div>
      </section>
    ))
  }

  <section class="cta-band section section--tight">
    <div class="container cta-band__inner">
      <h2 class="cta-band__title" data-reveal>欢迎实地考察我们的产线</h2>
      <p class="muted" data-reveal>如需了解设备清单、产能排期或安排样品试制，欢迎随时联系我们。</p>
      <a class="btn btn--solid" href="/contact" data-reveal>联系我们</a>
    </div>
  </section>

</Layout>
