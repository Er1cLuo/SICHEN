---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import VideoPlaceholder from '../components/VideoPlaceholder.astro';
import ProductCard from '../components/ProductCard.astro';
import Carousel from '../components/Carousel.astro';

// 提示：以下为演示内容。统计数据与文案为占位，图片为占位图（同名覆盖即可）。
const stats = [
  { num: '15', suffix: '+', label: '年行业深耕' },
  { num: '500', suffix: '+', label: '服务客户' },
  { num: '15', suffix: '+', label: '出口国家与地区' },
  { num: '98.5', suffix: '%', label: '一次交验合格率' },
];

const businesses = [
  {
    title: '冷镦紧固件',
    desc: '螺丝、螺母等冷镦紧固件，规格齐全，头型、牙型与表面处理可按图纸定制。',
    tag: 'COLD HEADING FASTENERS',
    src: '/images/products/screw/screw-4.jpg',
    href: '/products#screw',
  },
  {
    title: '多工位异形件',
    desc: '多工位冷镦一次成型的异形件，替代多道切削工序，强度与效率更优。',
    tag: 'MULTI-STATION SPECIAL PARTS',
    src: '/images/products/special/special-1.jpg',
    href: '/products#special',
  },
  {
    title: '车床件',
    desc: '自动车床与数控走心机加工的回转体零件，轴类、套类与异形小件，尺寸一致性好。',
    tag: 'CNC TURNED PARTS',
    src: '/images/products/turning/turning-1.png',
    href: '/products#turning',
  },
  {
    title: '垫片/配套件',
    desc: '平垫、弹垫及各类配套件，冲压成型、尺寸稳定，可与紧固件配套供应。',
    tag: 'WASHERS & ACCESSORIES',
    src: '/images/products/washer/washer-1.png',
    href: '/products#washer',
  },
];

// 厂区展示（首页展示 5 大部分，详情见 /workshops）
const workshops = [
  {
    id: 'part-1',
    eyebrow: 'PART 01',
    title: '冷镦成型',
    summary: '多工位冷镦生产车间、冷镦螺丝生产车间与一般冷镦生产车间。',
    src: '/images/workshops/cold-heading-1.jpg',
  },
  {
    id: 'part-2',
    eyebrow: 'PART 02',
    title: '搓牙',
    summary: '0# 搓牙机、一分半搓牙机与大型搓丝机三个车间，覆盖 M0.6 ~ M24 螺纹。',
    src: '/images/workshops/thread-rolling-1.png',
  },
  {
    id: 'part-3',
    eyebrow: 'PART 03',
    title: '数控加工',
    summary: '大型数控生产车间、小型数控生产车间与自动化车床生产车间。',
    src: '/images/workshops/cnc-1.jpg',
  },
  {
    id: 'part-4',
    eyebrow: 'PART 04',
    title: '光学筛选',
    summary: '光学影像全检，自动剔除尺寸超差、混料、毛刺等不良品。',
    src: '/images/workshops/optical-sorting-1.jpg',
  },
  {
    id: 'part-5',
    eyebrow: 'PART 05',
    title: '仓储',
    summary: '工具间、原料仓库与成品仓库，分区管理、批次可追溯。',
    src: '/images/factory/raw-warehouse.jpg',
  },
  {
    id: 'part-6',
    eyebrow: 'PART 06',
    title: '包装',
    summary: '自动计数包装，1000 粒误差不超过 1 粒，按批次登记入库。',
    src: '/images/factory/packing-1.png',
  },
];

// 公司概貌轮播图（4 张）
const overviewSlides = [
  { src: '/images/company/slider-1.jpg', alt: '公司厂区外景' },
  { src: '/images/company/slider-2.jpg', alt: '生产车间全景' },
  { src: '/images/company/slider-3.jpg', alt: '办公与产品展厅' },
  { src: '/images/company/slider-4.jpg', alt: '团队与品质管理' },
  { src: '/images/company/slider-5.png', alt: '公司概貌 · 第 5 张' },
];

// 涉及领域（8 个，各配一张矢量概念图）
const industries = [
  { title: '新能源', en: 'NEW ENERGY', src: '/images/industries/energy.jpg' },
  { title: '汽车制造', en: 'AUTOMOTIVE', src: '/images/industries/automotive.jpg' },
  { title: '建筑工程', en: 'CONSTRUCTION', src: '/images/industries/construction.jpg' },
  { title: '自动化器械', en: 'AUTOMATION', src: '/images/industries/automation.jpg' },
  { title: '信息通讯', en: 'TELECOM', src: '/images/industries/telecom.jpg' },
  { title: '办公设备', en: 'OFFICE EQUIPMENT', src: '/images/industries/office.jpg' },
  { title: '家用电器', en: 'HOME APPLIANCES', src: '/images/industries/appliance.jpg' },
  { title: '模具机床', en: 'MOLD & MACHINE TOOLS', src: '/images/industries/mold.jpg' },
];
---

<Layout
  title="思晨五金制品有限公司 · 精密五金制造"
  description="思晨五金制品有限公司——精密冲压件、精密CNC加工件、紧固件、钣金件等五金制品研发、制造与交付，服务全球工业客户。"
>

  <!-- ======== 首屏 ======== -->
  <section class="hero">
    <div class="hero__media">
      <!-- 首屏大图：public/images/equipment/hero.jpg（已压缩，原图备份在 originals/） -->
      <PlaceholderImage src="/images/equipment/hero.jpg" label="首屏主视觉" fill />
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>

    <div class="container hero__content">
      <p class="eyebrow" data-reveal>SICEN HARDWARE · 思晨五金</p>
      <h1 class="hero__title" data-reveal>
        以精密之心<br />铸工业之<em>美</em>
      </h1>
      <p class="hero__desc" data-reveal>
        思晨五金制品有限公司，专注精密冲压件、CNC 机加工件、紧固件等五金制品的
        研发、制造与交付。以严谨工艺、稳定品质与可靠交期，服务全球工业客户。
      </p>
      <div class="hero__actions" data-reveal>
        <a class="btn btn--solid" href="/products">浏览产品</a>
        <a class="btn btn--ghost" href="/about">了解思晨</a>
      </div>
    </div>

    <span class="hero__scroll" aria-hidden="true">SCROLL</span>
  </section>

  <!-- ======== 公司简介 ======== -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__body">
          <SectionHeading
            eyebrow="ABOUT SICEN"
            title="匠心制造，值得信赖"
            desc="思晨五金制品有限公司是一家专注于五金制品研发、制造与销售的企业，产品涵盖精密冲压件、精密机加工零件、紧固件、钣金件等，广泛应用于家电、汽车、电子与机械装备等行业。"
          />
          <p data-reveal>
            公司坚持“品质为先、客户至上”的经营理念，建立了覆盖来料检验、过程控制与出货检验的
            全流程质量管理体系，确保从图纸到交付的每一个环节都稳定可控。
          </p>
          <p data-reveal>
            无论是标准件询价还是定制化开发，我们都以专业与耐心回应每一次需求。
          </p>
          <div class="hero__actions" data-reveal style="margin-top: 36px">
            <a class="btn btn--ghost" href="/about">更多关于我们 →</a>
          </div>
        </div>
      <!-- 公司概貌轮播图（5 张）：替换 public/images/company/slider-1 ~ slider-5 同名文件即可 -->
        <div class="split__media">
          <Carousel slides={overviewSlides} aspect="4 / 3" />
        </div>
      </div>
    </div>
  </section>

  <!-- ======== 核心业务 ======== -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        eyebrow="OUR BUSINESS"
        title="核心业务"
        desc="从标准件到精密定制件，思晨为客户提供一站式的五金制品解决方案。"
        align="center"
      />
      <div class="card-grid" style="margin-top: 56px">
        {
          businesses.map((item) => (
            <ProductCard
              title={item.title}
              desc={item.desc}
              tag={item.tag}
              src={item.src}
              href={item.href}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======== 涉及领域 ======== -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="INDUSTRIES WE SERVE"
        title="涉及领域"
        desc="思晨五金的精密五金制品广泛应用于新能源、汽车、建筑、自动化、通讯、办公与家电等行业。"
        align="center"
      />
      <div class="industry-grid" style="margin-top: 52px">
        {
          industries.map((item) => (
            <div class="industry-item" data-reveal>
              <PlaceholderImage src={item.src} label={item.title} aspect="4/3" />
              <div class="industry-item__body">
                <p class="industry-item__en">{item.en}</p>
                <h3 class="industry-item__title">{item.title}</h3>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======== 数据统计 ======== -->
  <section class="section section--tight">
    <div class="container">
      <div class="stat-grid" data-reveal>
        {
          stats.map((item) => (
            <div class="stat">
              <div class="stat__num">
                {item.num}
                <span>{item.suffix}</span>
              </div>
              <div class="stat__label">{item.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======== 制造实力（内容宽横幅） ======== -->
  <section class="section section--tight">
    <div class="container">
      <div class="media-band">
        <PlaceholderImage src="/images/equipment/workshop-1.jpg" label="制造实力" fill />
        <div class="media-band__overlay" aria-hidden="true"></div>
        <div class="media-band__content">
          <p class="eyebrow" data-reveal>MANUFACTURING EXCELLENCE</p>
          <h2 class="h-section" data-reveal style="margin-top: 18px">
            从图纸到交付<br />全流程品质管控
          </h2>
          <p class="lead" data-reveal>
            冲压、机加、表面处理全工序自主可控，配合完善的检测体系，
            确保每一件产品都符合客户要求。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== 品牌视频 ======== -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="BRAND VIDEO"
        title="走进思晨"
        desc="一段视频，了解我们的工厂、工艺与团队。"
        align="center"
      />
      <div class="video-frame">
        <VideoPlaceholder
          src="/videos/video.mp4"
          poster="/videos/video.jpg"
          label="品牌视频"
        />
      </div>
    </div>
  </section>

  <!-- ======== 厂区展示 ======== -->
  <section class="section section--alt section--line">
    <div class="container">
      <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px">
        <SectionHeading
          eyebrow="OUR FACILITY"
          title="厂区展示"
          desc="冷镦成型、数控加工与仓储三大板块，完整呈现思晨的生产现场。"
        />
        <a class="btn btn--ghost btn--sm" href="/workshops" data-reveal>查看全部 →</a>
      </div>
      <div class="shop-grid shop-grid--3" style="margin-top: 48px">
        {
          workshops.map((item) => (
            <a class="shop-card" href={`/workshops#${item.id}`} data-reveal>
              <div class="shop-card__media">
                <PlaceholderImage src={item.src} label={item.title} aspect="16/9" />
              </div>
              <div class="shop-card__body">
                <p class="eyebrow">{item.eyebrow}</p>
                <h3 class="shop-card__title">{item.title}</h3>
                <p class="shop-card__desc">{item.summary}</p>
                <span class="card__link">查看详情 <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======== CTA ======== -->
  <section class="cta-band section section--tight">
    <div class="container cta-band__inner">
      <h2 class="cta-band__title" data-reveal>期待与您携手，共铸精品</h2>
      <p class="muted" data-reveal>无论是标准产品询价，还是定制化开发需求，欢迎随时联系我们。</p>
      <a class="btn btn--solid" href="/contact" data-reveal>联系我们</a>
    </div>
  </section>

</Layout>
