---
import { existsSync } from 'node:fs';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';

// 产品图：public/images/products/<分类>/<分类>-N.<扩展名>
// 构建时自动探测实际扩展名（jpg / png / webp…），所以你替换图片时用什么格式都行
const EXT = ['jpg', 'jpeg', 'png', 'webp'];
const gallery = (prefix, count) =>
  Array.from({ length: count }, (_, i) => {
    const base = `/images/products/${prefix}/${prefix}-${i + 1}`;
    const ext = EXT.find((e) => existsSync(`public${base}.${e}`)) ?? 'png';
    return { src: `${base}.${ext}`, index: i + 1 };
  });

const categories = [
  {
    id: 'nut',
    en: 'NUTS',
    title: '螺母类',
    desc: '标准件与非标螺母，规格齐全，可按图纸定制材质、牙型与表面处理，适合批量配套供货。',
    points: [
      '规格范围：M3 ~ M20（特殊规格可定制）',
      '常用材质：碳钢、不锈钢、黄铜',
      '表面处理：镀锌、发黑、达克罗',
      '应用领域：汽车、家电、建筑五金',
    ],
    items: gallery('nut', 6),
  },
  {
    id: 'screw',
    en: 'COLD HEADING SCREWS',
    title: '一般冷镦螺丝件',
    desc: '各类冷镦螺丝、螺钉，头型与牙型可按图定制，冷镦成型强度稳定，适合大批量持续供货。',
    points: [
      '规格范围：M2 ~ M12',
      '头型：盘头、沉头、六角、异形头',
      '材质：碳钢、不锈钢；表面：镀锌、镀镍、发黑',
      '交付：常规批量 7 ~ 15 天（按订单确认）',
    ],
    items: gallery('screw', 12),
  },
  {
    id: 'special',
    en: 'MULTI-STATION SPECIAL PARTS',
    title: '多工位冷镦异形件',
    desc: '多工位冷镦一次成型，替代多道切削工序，金属流线连续、强度更高，效率与成本优势明显。',
    points: [
      '杆径范围：φ3 ~ φ16',
      '工位数：3 ~ 6 工位连续成型',
      '支持来图来样开发，可先打样确认',
      '应用领域：汽车配件、自动化设备、五金结构件',
    ],
    items: gallery('special', 12),
  },
  {
    id: 'washer',
    en: 'STAMPING WASHERS',
    title: '冲压垫片',
    desc: '平垫、弹垫及各类异形垫片，冲压成型、尺寸稳定，可与紧固件配套供应。',
    points: [
      '厚度范围：0.3 ~ 4 mm',
      '材质：碳钢、不锈钢、铜',
      '表面处理：镀锌、发黑、本色',
      '应用领域：紧固件配套、电子、机械装配',
    ],
    items: gallery('washer', 3),
  },
  {
    id: 'turning',
    en: 'CNC TURNED PARTS',
    title: '车床件',
    desc: '自动车床与数控走心机加工的回转体零件，轴类、套类与异形小件一次装夹完成多道工序，尺寸一致性好。',
    points: [
      '加工范围：φ0.5 ~ φ20 mm',
      '材质：碳钢、不锈钢、黄铜、铝',
      '一次装夹可完成车、铣、钻、镗、攻等多道工序',
      '应用领域：电子、通讯、仪器仪表、汽车零部件',
    ],
    items: gallery('turning', 3),
  },
  {
    id: 'other',
    en: 'OTHER SPECIAL PARTS',
    title: '其他异形类',
    desc: '按客户图纸定制的其他异形五金零件，支持来图来样开发与小批量试制。',
    points: [
      '支持来图、来样开发',
      '可承接小批量打样与批量生产',
      '材质与表面处理按需求选定',
      '交期与价格按图纸评估后确认',
    ],
    items: gallery('other', 6),
  },
];

const steps = [
  { title: '需求沟通', desc: '了解产品图纸、材质、精度与数量要求，给出专业建议与报价。' },
  { title: '打样确认', desc: '样品制作与检测，确认尺寸、外观与性能符合要求后封样。' },
  { title: '批量生产', desc: '标准化产线批量生产，过程检验与抽检并行，保证品质稳定。' },
  { title: '品质交付', desc: '出货前全检/抽检，按约定交期准时交付，并提供完善的售后服务。' },
];
---

<Layout
  title="产品中心"
  description="思晨五金产品中心——螺母类、冷镦螺丝件、多工位冷镦异形件、冲压垫片、车床件及其他异形五金件。"
>

  <section class="page-hero page-hero--media">
    <!-- 页头背景大图：换图只需改下面这一行，或把同名文件放进 public/images/company/ 覆盖 -->
    <div class="page-hero__bg" aria-hidden="true">
      <img src="/images/company/showproduct.jpg" alt="" />
    </div>
    <div class="page-hero__scrim" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow" data-reveal>PRODUCTS</p>
      <h1 class="page-hero__title" data-reveal>产品中心</h1>
      <p class="page-hero__desc" data-reveal>
        螺母、冷镦螺丝、多工位冷镦异形件、垫片、车床件及其他异形零件，支持来图定制。
      </p>
      <nav class="anchor-nav" aria-label="产品分类导航">
        {
          categories.map((c) => (
            <a class="anchor-pill" href={`#${c.id}`}>
              {c.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    categories.map((cat, index) => (
      <section
        class:list={['section', { 'section--alt': index % 2 === 1 }]}
        id={cat.id}
      >
        <div class="container">
          <div class="cat-head" data-reveal>
            <div>
              <p class="eyebrow">{cat.en}</p>
              <h2 class="h-section">{cat.title}</h2>
            </div>
          </div>

          <div class="cat-body">
            <div class="cat-body__media">
              <div class="gallery-grid gallery-grid--3">
                {cat.items.map((item) => (
                  <div class="gallery-item" data-reveal>
                    <PlaceholderImage
                      src={item.src}
                      label={`${cat.title} ${item.index}`}
                      aspect="4/3"
                    />
                  </div>
                ))}
              </div>
            </div>

            <div class="cat-body__info" data-reveal>
              <p class="cat-intro">{cat.desc}</p>
              <ul class="cat-points">
                {cat.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <a class="btn btn--ghost btn--sm" href="/contact">咨询该类产品 →</a>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--alt">
    <div class="container">
      <SectionHeading eyebrow="HOW WE WORK" title="定制合作流程" align="center" />
      <div class="steps" style="margin-top: 52px">
        {
          steps.map((item, i) => (
            <div class="step" data-reveal>
              <div class="step__num">{String(i + 1).padStart(2, '0')}</div>
              <h3 class="step__title">{item.title}</h3>
              <p class="step__desc">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta-band section section--tight">
    <div class="container cta-band__inner">
      <h2 class="cta-band__title" data-reveal>有图纸或需求？欢迎询价</h2>
      <p class="muted" data-reveal>提供图纸或样品，我们将尽快为您评估工艺与报价。</p>
      <a class="btn btn--solid" href="/contact" data-reveal>发起询价</a>
    </div>
  </section>

</Layout>
