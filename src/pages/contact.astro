---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';

// 公司地址（真实地址）
const address = '广东省中山市三乡镇第二工业区皇冠路5号8栋之A区';

// 免 Key 的"一键导航"链接（点击后在对应地图站点打开并定位该地址）
const mapLinks = {
  amap: `https://uri.amap.com/search?keyword=${encodeURIComponent(address)}`,
  baidu: `https://map.baidu.com/search/${encodeURIComponent(address)}`,
};

// 提示：电话与邮箱仍为占位，请替换为真实信息（中山区号为 0760）
const contactItems = [
  { label: '公司地址', value: address },
  { label: '联系电话', value: '+86 0760-XXXX-XXXX（占位）' },
  { label: '电子邮箱', value: 'info@sicen-hardware.com（占位）' },
  { label: '工作时间', value: '周一至周六 8:30 – 18:00' },
];

/**
 * 地图嵌入位（可选，默认留空）
 *
 * 目前使用「位置示意图 + 一键导航按钮」，无需任何 Key，稳定可用。
 * 若需要真正的嵌入式地图，二选一后把地址填进 MAP_EMBED 即可自动切换为 iframe：
 *   A. 高德开放平台申请免费 Key，用「静态地图」图片地址，例如：
 *      https://restapi.amap.com/v3/staticmap?location=经度,纬度&zoom=16&size=1200*500&markers=mid,,A:经度,纬度&key=你的KEY
 *   B. 高德/腾讯地图控制台生成的官方地图组件嵌入地址（iframe）
 * 另外：把公司经纬度告诉我，我会写进 JSON-LD 结构化数据，利于本地搜索收录。
 */
const MAP_EMBED = '';
---

<Layout title="联系我们" description="联系思晨五金制品有限公司——欢迎咨询产品、询价与合作。">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow" data-reveal>CONTACT US</p>
      <h1 class="page-hero__title" data-reveal>联系我们</h1>
      <p class="page-hero__desc" data-reveal>
        无论是产品询价、定制开发还是商务合作，欢迎随时与我们取得联系。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div>
          <SectionHeading eyebrow="GET IN TOUCH" title="联系方式" />
          <ul class="info-list" style="margin-top: 36px">
            {
              contactItems.map((item) => (
                <li class="info-item" data-reveal>
                  <span class="info-item__label">{item.label}</span>
                  <span class="info-item__value">{item.value}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <SectionHeading eyebrow="SEND MESSAGE" title="在线留言" />
          <form class="form" id="contactForm" style="margin-top: 36px" data-reveal>
            <div class="form__row">
              <div class="field">
                <label for="name">姓名 *</label>
                <input id="name" name="name" type="text" placeholder="您的姓名" required />
              </div>
              <div class="field">
                <label for="company">公司</label>
                <input id="company" name="company" type="text" placeholder="公司名称" />
              </div>
            </div>
            <div class="form__row">
              <div class="field">
                <label for="phone">电话</label>
                <input id="phone" name="phone" type="tel" placeholder="联系电话" />
              </div>
              <div class="field">
                <label for="email">邮箱 *</label>
                <input id="email" name="email" type="email" placeholder="电子邮箱" required />
              </div>
            </div>
            <div class="field">
              <label for="message">留言内容 *</label>
              <textarea id="message" name="message" placeholder="请描述您的需求，例如产品、数量、材质要求……" required></textarea>
            </div>
            <button class="btn btn--solid" type="submit">发送留言</button>
            <p class="form__note" style="margin-top: 14px">
              （演示占位表单，尚未接入后端；上线后可对接邮件或表单服务）
            </p>
            <p class="form__success" id="formSuccess">✓ 留言已记录（占位）。上线后请接入真实后端或邮件通知。</p>
          </form>
        </div>
      </div>

    </div>
  </section>

  <!-- ======== 公司位置 ======== -->
  <section class="section section--alt" id="location">
    <div class="container">
      <SectionHeading
        eyebrow="LOCATION"
        title="公司位置"
        desc="公司位于广东省中山市三乡镇，紧邻珠三角主要城市，欢迎来访考察（建议提前电话预约）。"
        align="center"
      />

      <div class="map-card" style="margin-top: 48px" data-reveal>
        <div class="map-card__media">
          {
            MAP_EMBED ? (
              <iframe
                class="map-frame"
                src={MAP_EMBED}
                title="公司位置地图"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              />
            ) : (
              <PlaceholderImage
                src="/images/company/map-1.png"
                label="公司位置示意图（可换成地图截图）"
                aspect="21/9"
              />
            )
          }
        </div>
        <div class="map-card__body">
          <div class="map-card__info">
            <p class="map-card__label">公司地址</p>
            <p class="map-card__address">{address}</p>
          </div>
          <div class="map-card__actions">
            <a class="btn btn--solid btn--sm" href={mapLinks.amap} target="_blank" rel="noopener">
              高德地图导航
            </a>
            <a class="btn btn--ghost btn--sm" href={mapLinks.baidu} target="_blank" rel="noopener">
              百度地图导航
            </a>
            <button class="btn btn--ghost btn--sm" type="button" id="copyAddress" data-address={address}>
              复制地址
            </button>
          </div>
        </div>
      </div>

      <p class="muted" style="margin-top: 20px; font-size: 13px" data-reveal>
        小贴士：把地图 App 里的位置截图保存为
        <code>public/images/company/map-1.png</code> 同名覆盖，即可替换这张示意图；如需可交互地图，申请高德
        Key 后在 <code>contact.astro</code> 的 <code>MAP_EMBED</code> 填入嵌入地址。
      </p>
    </div>
  </section>

  <script>
    // 复制地址
    const copyBtn = document.getElementById('copyAddress');
    copyBtn?.addEventListener('click', async () => {
      const text = copyBtn.getAttribute('data-address') ?? '';
      const original = copyBtn.textContent;
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = '已复制 ✓';
      } catch {
        copyBtn.textContent = '请手动选择复制';
      }
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 2000);
    });

    // 留言表单（演示：仅前端提示）
    const form = document.getElementById('contactForm');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const success = document.getElementById('formSuccess');
      success?.classList.add('show');
      form.reset();
      setTimeout(() => success?.classList.remove('show'), 6000);
    });
  </script>

</Layout>
