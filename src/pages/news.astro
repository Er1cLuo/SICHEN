---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import NewsCard from '../components/NewsCard.astro';

// 提示：以下新闻均为占位内容。如需文章详情页，可新增 src/pages/news/[slug].astro。
const featured = {
  title: '思晨五金通过 ISO9001 质量管理体系年度审核',
  date: '2025-06-18',
  category: '企业新闻',
  excerpt:
    '近日，思晨五金制品有限公司顺利通过 ISO9001 质量管理体系年度监督审核。审核组对公司从供应商管理、过程控制到出货检验的全流程质量管理给予了充分肯定。质量管理体系的持续有效运行，为公司稳定交付与品质管控提供了坚实保障。',
  src: '/images/news/news-1.png',
};

const news = [
  {
    title: '公司精密冲压自动化产线完成升级改造',
    date: '2025-05-30',
    category: '企业新闻',
    excerpt: '自动化程度与生产效率进一步提升，更好地满足客户对交期与品质的双重要求。',
    src: '/images/news/news-2.png',
  },
  {
    title: '2025 上半年五金行业景气度观察',
    date: '2025-05-12',
    category: '行业动态',
    excerpt: '下游需求稳步回暖，精密五金制造向智能化、绿色化方向持续演进。',
    src: '/images/news/news-3.png',
  },
  {
    title: '思晨五金参加华南国际工业博览会',
    date: '2025-04-08',
    category: '展会动态',
    excerpt: '与众多行业客户深入交流，展示公司在精密冲压与机加领域的最新能力。',
    src: '/images/news/news-4.png',
  },
  {
    title: '新引进五轴联动加工中心，精密加工能力再升级',
    date: '2025-03-21',
    category: '企业新闻',
    excerpt: '进一步拓展复杂曲面与高精度零件的加工能力，服务更多高端应用场景。',
    src: '/images/news/news-5.png',
  },
  {
    title: '关于不锈钢紧固件防腐性能的几点建议',
    date: '2025-02-27',
    category: '技术分享',
    excerpt: '材质选择、表面处理与使用环境都会影响紧固件的防腐表现，本文给出实用建议。',
    src: '/images/news/news-6.png',
  },
];
---

<Layout title="新闻资讯" description="思晨五金新闻资讯——企业新闻、行业动态、展会信息与技术分享。">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow" data-reveal>NEWS & INSIGHTS</p>
      <h1 class="page-hero__title" data-reveal>新闻资讯</h1>
      <p class="page-hero__desc" data-reveal>
        了解思晨的最新动态，以及五金制造行业的前沿信息。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="FEATURED" title="头条新闻" />

      <a class="news-featured" href="/news" style="margin-top: 44px" data-reveal>
        <div class="card__media" style="min-height: 300px">
          <PlaceholderImage src={featured.src} label={featured.title} aspect="16/9" />
        </div>
        <div class="news-featured__body">
          <div class="news-card__meta">
            <span class="tag">{featured.category}</span>
            <time class="news-card__date">{featured.date}</time>
          </div>
          <h3 class="news-card__title" style="margin-top: 22px; font-size: 24px">{featured.title}</h3>
          <p class="news-card__excerpt" style="margin-top: 16px">{featured.excerpt}</p>
          <span class="card__link" style="margin-top: 24px">阅读全文 <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <div class="news-grid" style="margin-top: 48px">
        {
          news.map((item) => (
            <NewsCard
              title={item.title}
              date={item.date}
              category={item.category}
              excerpt={item.excerpt}
              src={item.src}
            />
          ))
        }
      </div>
    </div>
  </section>

</Layout>
