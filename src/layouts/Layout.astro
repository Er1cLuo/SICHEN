---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '思晨五金制品有限公司——精密五金制品研发、制造与交付，服务全球工业客户。' } =
  Astro.props;

const siteTitle = title.includes('思晨') ? title : `${title} | 思晨五金制品有限公司`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// 社交分享图（1200×630）：图片在 public/images/company/og-cover.jpg，换图同名覆盖即可
const siteUrl = (Astro.site?.href ?? 'https://www.sicenhardware.com/').replace(/\/$/, '');
const ogImage = `${siteUrl}/images/company/og-cover.jpg`;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '思晨五金制品有限公司',
  alternateName: 'Sicen Hardware Products Co., Ltd.',
  description: '精密五金制品研发、制造与销售，服务全球工业客户。',
  url: 'https://www.sicenhardware.com/', // 上线后替换为正式域名
  logo: 'https://www.sicenhardware.com/logo.svg',
  email: '2724247155@qq.com', // 企业邮箱
  telephone: '+8613928180479',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '三乡镇第二工业区皇冠路5号8栋之A区',
    addressLocality: '中山市',
    addressRegion: '广东省',
    addressCountry: 'CN',
  },
  // 公司坐标（GCJ-02，高德地理编码反查所得），利于地图/本地搜索收录
  geo: {
    '@type': 'GeoCoordinates',
    longitude: '113.414460',
    latitude: '22.348405',
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="思晨五金制品有限公司" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="思晨五金制品有限公司" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {canonical && <link rel="canonical" href={canonical} />}

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </head>
  <body>
    <Header current={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // 滚动浮现动画
      const revealEls = document.querySelectorAll('[data-reveal]');

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
